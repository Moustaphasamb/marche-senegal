{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/:page(marche-senegal-[a-z0-9-]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "marche-senegal-{marche,boutique,produit}.html"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/marche-senegal-accueil.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/marche-senegal-accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:page(marche-senegal-[a-z0-9-]+).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/marche-senegal-accueil.html"
    },
    {
      "source": "/:page(marche-senegal-[a-z0-9-]+)",
      "destination": "/:page.html"
    },
    {
      "source": "/marches/:cle",
      "destination": "/api/page?type=marche&cle=:cle"
    },
    {
      "source": "/boutiques/:cle",
      "destination": "/api/page?type=boutique&cle=:cle"
    },
    {
      "source": "/produits/:cle",
      "destination": "/api/page?type=produit&cle=:cle"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
