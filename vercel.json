{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/:page(admin|ajout-produit|boutique|chat|commande|connexion-acheteur|connexion-admin|connexion-vendeur|dashboard|garantie|ma-boutique|marche|mes-commandes|mes-produits|mes-revenus|mes-stories|modifier-produit|mot-de-passe-oublie|panier|produit|profil|recherche|reclamation|shopvision)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "marche-senegal-{marche,boutique,produit}.html"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/marche-senegal-accueil.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/marche-senegal-accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/marche-senegal-:page(admin|ajout-produit|boutique|chat|commande|connexion-acheteur|connexion-admin|connexion-vendeur|dashboard|garantie|ma-boutique|marche|mes-commandes|mes-produits|mes-revenus|mes-stories|modifier-produit|mot-de-passe-oublie|panier|produit|profil|recherche|reclamation|shopvision).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/marche-senegal-:page(admin|ajout-produit|boutique|chat|commande|connexion-acheteur|connexion-admin|connexion-vendeur|dashboard|garantie|ma-boutique|marche|mes-commandes|mes-produits|mes-revenus|mes-stories|modifier-produit|mot-de-passe-oublie|panier|produit|profil|recherche|reclamation|shopvision)",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/marche-senegal-accueil.html"
    },
    {
      "source": "/:page(admin|ajout-produit|boutique|chat|commande|connexion-acheteur|connexion-admin|connexion-vendeur|dashboard|garantie|ma-boutique|marche|mes-commandes|mes-produits|mes-revenus|mes-stories|modifier-produit|mot-de-passe-oublie|panier|produit|profil|recherche|reclamation|shopvision)",
      "destination": "/marche-senegal-:page.html"
    },
    {
      "source": "/marches/:cle",
      "destination": "/api/page?type=marche&cle=:cle"
    },
    {
      "source": "/boutiques/:cle",
      "destination": "/api/page?type=boutique&cle=:cle"
    },
    {
      "source": "/produits/:cle",
      "destination": "/api/page?type=produit&cle=:cle"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
